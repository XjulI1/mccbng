{
  "name": "@mccbng/front",
  "description": "Front mccbng : mCloud Compte and Budget Next Generation",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:staging": "nuxt build --envName test",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "nuxt typecheck",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "docker:staging:build": "docker buildx build --platform linux/amd64 -f Dockerfile -t dockregistry.xju.fr/mccbng/front:staging ..",
    "docker:staging:push": "docker push dockregistry.xju.fr/mccbng/front:staging",
    "docker:latest:build": "docker buildx build --platform linux/amd64 -f Dockerfile -t dockregistry.xju.fr/mccbng/front:latest ..",
    "docker:latest:push": "docker push dockregistry.xju.fr/mccbng/front:latest",
    "docker:run": "docker run -p 8080:8080 -e API_URL=http://host.docker.internal:3000 -d front",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@pinia/nuxt": "^1.0.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "eruda": "^3.4.3",
    "highcharts": "^12.2.0",
    "nuxt": "4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.13",
    "vue3-touch-events": "^4.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^25.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "h3-next": "npm:h3@2.0.1-rc.32",
    "happy-dom": "^20.14.5",
    "lint-staged": "^15.4.0",
    "sass": "^1.86.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  },
  "_id": "mccbng_front@1.0.0",
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ]
  },
  "readme": "ERROR: No README data found!"
}
