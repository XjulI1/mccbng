{
  "name": "mccbng",
  "description": "mccbng : mCloud Compte and Budget Next Generation",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "repository": "git@github.com:XjulI1/mccbng.git",
  "author": "Xavier JULIEN <xavijulien@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:staging": "nuxt build --envName test",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "nuxt typecheck",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "docker:staging:build": "docker buildx build --platform linux/amd64 -f Dockerfile -t dockregistry.xju.fr/mccbng/front:staging .",
    "docker:staging:push": "docker push dockregistry.xju.fr/mccbng/front:staging",
    "docker:latest:build": "docker buildx build --platform linux/amd64 -f Dockerfile -t dockregistry.xju.fr/mccbng/front:latest .",
    "docker:latest:push": "docker push dockregistry.xju.fr/mccbng/front:latest",
    "docker:run": "docker run -p 8080:8080 -e DB_HOST=host.docker.internal -e DB_PORT=3306 -e DB_USER=... -e DB_PASSWORD=... -e DB_NAME=... -e JWT_SECRET=... -d front",
    "postinstall": "nuxt prepare",
    "db:migrate": "node scripts/db-migrate.mjs",
    "hash-code": "node scripts/hash-code.mjs",
    "test:api": "vitest run --config vitest.api.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@pinia/nuxt": "^1.0.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "eruda": "^3.4.3",
    "heic-to": "^1.5.2",
    "highcharts": "^12.6.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nuxt": "4.5.2",
    "nuxt-security": "^2.7.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue3-touch-events": "^4.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@testcontainers/mariadb": "^12.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "h3-next": "npm:h3@2.0.1",
    "happy-dom": "^20.14.6",
    "lint-staged": "^17.6.0",
    "sass": "^1.106.1",
    "testcontainers": "^12.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ]
  }
}
